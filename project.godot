; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

"ï»¿config_version"=5

[application]

config/name="Pearl of Southeast"
config/description="A 2D top-down action-adventure game inspired by Philippine landscapes and cultural diversity."
run/main_scene="res://scenes/main_menu/MainMenu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

WordValidator="*res://scripts/systems/WordValidator.gd"
InventoryManager="*res://scripts/systems/InventoryManager.gd"
AudioManager="*res://scripts/systems/AudioManager.gd"
DamageCalculator="*res://scripts/systems/DamageCalculator.gd"
GameManager="*res://scripts/systems/GameManager.gd"
SaveManager="*res://scripts/systems/SaveManager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

